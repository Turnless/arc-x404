# Copy to .env and fill in. Never put a private key here: sign with cast keystores
# (--account arc-deployer / arc-payer / arc-checker) instead.
ARC_RPC_URL=https://rpc.mainnet.arc.io
# mainnet (default) or testnet; the checker reads this
ARC_NETWORK=mainnet

# Public addresses only
DEPLOYER=
PAYER=
# Address of the arc-checker keystore (signs trust permits; needs no funds)
CHECKER=
# Lowest trust score out of 10 that may review (deploy setting, default 7)
MIN_TRUST=7

# Filled in after RegisterAgents and DeployPaidReviews. Use only agent ids you own:
# ids 0, 1, 2, ... already exist on Arc mainnet with unrelated owners.
GATE=
# Block the gate was deployed in (the checker scans gate events from here)
GATE_DEPLOY_BLOCK=
AGENT_ID_1=
AGENT_ID_2=

# Filled in after PayDemo (receipt ids it logs; confirm in the Paid events)
RECEIPT_1=
RECEIPT_2=
RECEIPT_3=

# Withdraw.s.sol destination (only needed for agents in Hold mode)
WITHDRAW_TO=
